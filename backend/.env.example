# Anthropic 兼容端点（留空使用官方端点）
ANTHROPIC_BASE_URL=
# 凭据：API_KEY 与 AUTH_TOKEN 二选一
ANTHROPIC_API_KEY=
# ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
# ANTHROPIC_SMALL_FAST_MODEL=
API_TIMEOUT_MS=300000

# MCP 配置（留空禁用 MCP）
MCP_CONFIG_PATH=../mcp.json

# 工作区（默认基于项目根，一般无需修改）
# SKILLS_DIR=
# EIDO_DATA_ROOT=
# LOG_DIR=
# LOG_LEVEL=INFO
