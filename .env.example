ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6
EIDO_PORT=8000
SKILLS_DIR=./.claude/skills
LOG_DIR=./logs
EIDO_DATA_DIR=./.eido
AGENT_HARNESS=claude_code  # claude_code | opencode
MCP_CONFIG_PATH=../mcp.json # backend/ 下运行时；Docker 使用 /etc/eido/mcp.json
MCP_CONFIG_FILE=./mcp.json  # Docker 宿主机挂载文件
OPENCODE_MODEL=             # 推荐显式设置，格式 provider/model，例如 zai/glm-5.1
# OpenCode 高级配置二选一；详见 docs/opencode.md
# OPENCODE_CONFIG=/absolute/path/to/opencode.json
# OPENCODE_CONFIG_CONTENT={"$schema":"https://opencode.ai/config.json","model":"zai/glm-5.1","share":"disabled"}
API_TIMEOUT_MS=300000

# ─── 多模型配置 ───────────────────────────────────────────────
# MODELS_CONFIG 是一个 JSON 数组，每个元素描述一个可选模型。
# 请求时通过 chat 接口的 model_id 字段选择模型。
# 留空则使用上方的 ANTHROPIC_* / OPENCODE_MODEL 等扁平变量（向后兼容）。
#
# 字段说明:
#   id              模型唯一标识，请求时传入
#   name            显示名称（可选）
#   harness         使用的后端: claude_code | opencode
#   base_url        API 地址（claude_code 使用）
#   api_key         API Key（claude_code 使用）
#   auth_token      Auth Token（claude_code 使用，可选）
#   model           模型名；claude_code 传给 ANTHROPIC_MODEL，opencode 传 --model
#   small_fast_model 快速模型名（claude_code 使用，可选）
#
# 示例:
# MODELS_CONFIG=[{"id":"claude-sonnet","name":"Claude Sonnet 4.6","harness":"claude_code","base_url":"https://api.anthropic.com","api_key":"sk-xxx","model":"claude-sonnet-4-6","small_fast_model":"claude-haiku-4-5"},{"id":"glm-5","name":"GLM-5.1","harness":"opencode","model":"zai/glm-5.1"}]
# DEFAULT_MODEL_ID=claude-sonnet
MODELS_CONFIG=
DEFAULT_MODEL_ID=
