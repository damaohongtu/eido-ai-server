ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=sk-xxx
ANTHROPIC_MODEL=claude-sonnet-4-6
EIDO_PORT=8000
SKILLS_DIR=./.claude/skills
LOG_DIR=./logs
EIDO_DATA_DIR=./.eido
AGENT_HARNESS=claude_code  # claude_code | opencode
MCP_CONFIG_PATH=../mcp.json # backend/ 下运行时；Docker 使用 /etc/eido/mcp.json
MCP_CONFIG_FILE=./mcp.json  # Docker 宿主机挂载文件
OPENCODE_MODEL=             # 推荐显式设置，格式 provider/model，例如 zai/glm-5.1
# OpenCode 高级配置二选一；详见 docs/opencode.md
# OPENCODE_CONFIG=/absolute/path/to/opencode.json
# OPENCODE_CONFIG_CONTENT={"$schema":"https://opencode.ai/config.json","model":"zai/glm-5.1","share":"disabled"}
API_TIMEOUT_MS=300000
